if(NOT DEFINED ROUTECRAFT_EXECUTABLE OR NOT EXISTS "${ROUTECRAFT_EXECUTABLE}")
    message(FATAL_ERROR "ROUTECRAFT_EXECUTABLE must point to the built routecraft executable")
endif()
if(NOT DEFINED ROUTECRAFT_FIXTURE OR NOT EXISTS "${ROUTECRAFT_FIXTURE}")
    message(FATAL_ERROR "ROUTECRAFT_FIXTURE must point to a valid .vrp fixture")
endif()
if(NOT DEFINED ROUTECRAFT_INVALID_FIXTURE OR NOT EXISTS "${ROUTECRAFT_INVALID_FIXTURE}")
    message(FATAL_ERROR "ROUTECRAFT_INVALID_FIXTURE must point to an invalid .vrp fixture")
endif()

function(require_contains value expected context)
    string(FIND "${value}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "${context}: expected output to contain '${expected}', got '${value}'")
    endif()
endfunction()

function(run_solve name expected_result expected_stdout expected_stderr)
    execute_process(
        COMMAND "${ROUTECRAFT_EXECUTABLE}" ${ARGN}
        RESULT_VARIABLE actual_result
        OUTPUT_VARIABLE actual_stdout
        ERROR_VARIABLE actual_stderr
    )
    if(NOT actual_result EQUAL expected_result)
        message(FATAL_ERROR "${name}: expected exit code ${expected_result}, got ${actual_result}")
    endif()
    if(expected_stdout STREQUAL "empty" AND NOT actual_stdout STREQUAL "")
        message(FATAL_ERROR "${name}: stdout must be empty, got '${actual_stdout}'")
    endif()
    if(expected_stderr STREQUAL "empty" AND NOT actual_stderr STREQUAL "")
        message(FATAL_ERROR "${name}: stderr must be empty, got '${actual_stderr}'")
    endif()
    if(expected_stderr STREQUAL "nonempty" AND actual_stderr STREQUAL "")
        message(FATAL_ERROR "${name}: stderr must contain a diagnostic")
    endif()
    set(${name}_stdout "${actual_stdout}" PARENT_SCOPE)
endfunction()

run_solve(json 0 json empty solve --input "${ROUTECRAFT_FIXTURE}" --method nn --format json)
require_contains("${json_stdout}" "\"instance\": \"cli-noncontiguous\"" "json instance")
require_contains("${json_stdout}" "\"routes\": [[0, 1, 2, 0]]" "json routes")
require_contains("${json_stdout}" "\"route_loads\": [9]" "json loads")
require_contains("${json_stdout}" "\"route_distances\": [15]" "json distances")
require_contains("${json_stdout}" "\"total_distance\": 15" "json total")
require_contains("${json_stdout}" "\"feasible\": true" "json feasibility")
require_contains("${json_stdout}" "\"internal_index\": 0, \"original_id\": \"50\"" "json depot map")
require_contains("${json_stdout}" "\"internal_index\": 1, \"original_id\": \"9\"" "json customer map")
require_contains("${json_stdout}" "\"internal_index\": 2, \"original_id\": \"70\"" "json customer map")

run_solve(txt 0 txt empty solve --input "${ROUTECRAFT_FIXTURE}" --method nn --format txt)
require_contains("${txt_stdout}" "Route 1: 50 -> 9 -> 70 -> 50 | Load: 9 | Distance: 15" "txt route")
require_contains("${txt_stdout}" "Total distance: 15" "txt total")

run_solve(missing_input 1 empty nonempty solve --input "does-not-exist.vrp" --method nn --format json)
run_solve(invalid_input 1 empty nonempty solve --input "${ROUTECRAFT_INVALID_FIXTURE}" --method nn --format json)
run_solve(unsupported_method 2 empty nonempty solve --input "${ROUTECRAFT_FIXTURE}" --method cw --format json)
run_solve(unsupported_format 2 empty nonempty solve --input "${ROUTECRAFT_FIXTURE}" --method nn --format csv)
run_solve(unsupported_parameter 2 empty nonempty solve --input "${ROUTECRAFT_FIXTURE}" --method nn --format json --output result.json)
run_solve(missing_parameter 2 empty nonempty solve --input "${ROUTECRAFT_FIXTURE}" --method nn)
